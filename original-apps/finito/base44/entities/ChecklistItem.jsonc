{
  "name": "ChecklistItem",
  "type": "object",
  "properties": {
    "name_en": {
      "type": "string",
      "description": "Task name in English"
    },
    "name_he": {
      "type": "string",
      "description": "Task name in Hebrew"
    },
    "name_ja": {
      "type": "string",
      "description": "Task name in Japanese"
    },
    "name_fr": {
      "type": "string",
      "description": "Task name in French"
    },
    "name_ru": {
      "type": "string",
      "description": "Task name in Russian"
    },
    "description_en": {
      "type": "string",
      "description": "Task description in English"
    },
    "description_he": {
      "type": "string",
      "description": "Task description in Hebrew"
    },
    "description_ja": {
      "type": "string",
      "description": "Task description in Japanese"
    },
    "description_fr": {
      "type": "string",
      "description": "Task description in French"
    },
    "description_ru": {
      "type": "string",
      "description": "Task description in Russian"
    },
    "work_area": {
      "type": "string",
      "enum": [
        "floor",
        "bar",
        "host",
        "kitchen",
        "cleaning"
      ],
      "description": "Work area this task belongs to"
    },
    "checklist_type": {
      "type": "string",
      "enum": [
        "opening",
        "closing",
        "both"
      ],
      "description": "Whether this task is for opening, closing, or both checklists"
    },
    "photo_requirement": {
      "type": "string",
      "enum": [
        "none",
        "optional",
        "required"
      ],
      "default": "none",
      "description": "Photo requirement for this task"
    },
    "recurring_schedule": {
      "type": "string",
      "enum": [
        "always",
        "specific_days"
      ],
      "default": "always",
      "description": "Whether task appears daily or only on specific days"
    },
    "days_of_week": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sunday",
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday"
        ]
      },
      "description": "Days when this task appears (if recurring_schedule is specific_days)"
    },
    "example_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Example/reference images for this task showing how it should be done"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Order of task in checklist"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this task is active"
    }
  },
  "required": [
    "name_en",
    "work_area",
    "checklist_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
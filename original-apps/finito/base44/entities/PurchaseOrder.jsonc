{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Auto-generated order number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "received",
        "partial"
      ],
      "default": "draft",
      "description": "Order status"
    },
    "supplier_name": {
      "type": "string",
      "description": "Supplier name"
    },
    "supplier_email": {
      "type": "string",
      "description": "Supplier email address"
    },
    "supplier_phone": {
      "type": "string",
      "description": "Supplier WhatsApp/phone number"
    },
    "items": {
      "type": "array",
      "description": "Array of ordered items",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "name_he": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "quantity_ordered": {
            "type": "number"
          },
          "quantity_received": {
            "type": "number"
          },
          "work_area": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Order notes"
    },
    "sent_at": {
      "type": "string",
      "description": "When order was sent"
    },
    "received_at": {
      "type": "string",
      "description": "When order was received"
    },
    "total_items": {
      "type": "number"
    }
  },
  "required": [
    "supplier_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}